# Neon Postgres 연결 문자열 (pooled 권장)
# Vercel 에서 Neon 을 프로젝트에 연결하면 자동으로 들어간다. 로컬은 `vercel env pull .env.local`
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Vercel Blob (스크린샷). Blob 스토어를 프로젝트에 연결하면 자동으로 들어간다.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# 세션 쿠키 서명용 비밀키 (32자 이상). 생성: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string
